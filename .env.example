# Copy this file to ".env" (same folder) and fill in what you need.
# Everything works without keys; these only switch on extra features.

# Ports (leave as they are unless something else uses them)
PORT=3000
HTTPS_PORT=3443

# Rishi AI with Google Gemini — free key: https://aistudio.google.com  → "Get API key"
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Snap the Real Sky — free key: https://nova.astrometry.net  → sign in → API key
ASTROMETRY_API_KEY=
